{
  "kind": "collectionType",
  "collectionName": "titles",
  "info": {
    "singularName": "title",
    "pluralName": "titles",
    "displayName": "称号"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 32
    },
    "description": {
      "type": "text",
      "maxLength": 200
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "rarity": {
      "type": "enumeration",
      "enum": ["common", "rare", "epic", "legendary", "special"],
      "default": "common"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "condition": {
      "type": "json"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
